import { useState } from "react";
import { Copy, Check, ExternalLink, X } from "lucide-react";
import { shortAddress, formatDateTime, normalizeTimestamp } from "@/lib/format";

function CopyButton({ text }: { text: string }) {
  const [copied, setCopied] = useState(false);
  return (
    <button
      onClick={() => {
        navigator.clipboard.writeText(text);
        setCopied(true);
        setTimeout(() => setCopied(false), 1400);
      }}
      style={{ background: "transparent", border: "none", cursor: "pointer", color: copied ? "#7fe0ac" : "#8798a8", display: "inline-flex", padding: 2 }}
      title="Copy"
    >
      {copied ? <Check size={12} /> : <Copy size={12} />}
    </button>
  );
}

function Row({ label, children }: { label: string; children: React.ReactNode }) {
  return (
    <div style={{ marginTop: 8 }}>
      <div style={{ fontSize: 9, letterSpacing: 0.8, color: "#66757f", textTransform: "uppercase" }}>{label}</div>
      <div style={{ fontSize: 12, color: "#e6edf3", marginTop: 2, display: "flex", alignItems: "center", gap: 4, wordBreak: "break-all" }}>
        {children}
      </div>
    </div>
  );
}

/**
 * Edge (transaction) details. `edge` is the graph link object built by
 * buildGraphData (GraphEdge): totalValue, asset, count, txHashes, lastTx...
 */
export function TransactionPanel({ edge, onClose }: { edge: any; onClose: () => void }) {
  const tx = edge?.lastTx;
  if (!tx) return null;

  const fmt = (n: number) => n.toLocaleString("en-US", { maximumFractionDigits: 6 });

  return (
    <aside
      style={{
        position: "absolute",
        left: 14,
        bottom: 14,
        width: 330,
        maxHeight: "70%",
        overflowY: "auto",
        background: "#0f151b",
        border: "1px solid #283440",
        borderRadius: 10,
        padding: "12px 14px",
        zIndex: 9,
        boxShadow: "0 8px 24px rgba(0,0,0,0.4)",
      }}
    >
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
        <span style={{ fontSize: 10, letterSpacing: 1, color: "#66757f", fontWeight: 700 }}>TRANSACTION</span>
        <button onClick={onClose} style={{ background: "transparent", border: "none", color: "#66757f", cursor: "pointer" }}>
          <X size={16} />
        </button>
      </div>

      <Row label="Network">TRON</Row>
      <Row label="Type">{tx.transaction_type ?? "-"}</Row>
      <Row label="Asset">{edge.asset}</Row>
      <Row label="Amount">
        {fmt(edge.totalValue)} {edge.asset}
        {edge.count > 1 ? ` (${edge.count} transactions)` : ""}
      </Row>
      <Row label="From">
        <code>{shortAddress(tx.from, 8, 6)}</code>
        <CopyButton text={tx.from} />
      </Row>
      <Row label="To">
        <code>{shortAddress(tx.to, 8, 6)}</code>
        <CopyButton text={tx.to} />
      </Row>
      <Row label="Hop">{edge.hop}</Row>
      <Row label={edge.count > 1 ? "Latest transaction hash" : "Transaction hash"}>
        <code>{shortAddress(tx.tx_hash, 10, 8)}</code>
        <CopyButton text={tx.tx_hash} />
        <a
          href={`https://tronscan.org/#/transaction/${tx.tx_hash}`}
          target="_blank"
          rel="noreferrer"
          style={{ color: "#66757f", display: "inline-flex", marginLeft: "auto" }}
          title="View on Tronscan"
        >
          <ExternalLink size={12} />
        </a>
      </Row>
      <Row label="Block">{tx.block_number || "-"}</Row>
      <Row label="Timestamp">{tx.timestamp ? formatDateTime(normalizeTimestamp(tx.timestamp)) : "-"}</Row>
      {tx.contract_type && <Row label="Contract type">{tx.contract_type}</Row>}
      {tx.contract_address && (
        <Row label="Token contract">
          <code>{shortAddress(tx.contract_address, 8, 6)}</code>
          <CopyButton text={tx.contract_address} />
        </Row>
      )}
    </aside>
  );
}